# Copy to .env and adjust for the host. Do not commit secrets.
FORGEJO_HTTP_BIND=127.0.0.1
FORGEJO_SSH_BIND=127.0.0.1
FORGEJO_ROOT_URL=http://127.0.0.1:3000/
FORGEJO_DOMAIN=127.0.0.1
FORGEJO_SSH_DOMAIN=127.0.0.1
FORGEJO_UID=1000
FORGEJO_GID=1000
FORGEJO_INSTALL_LOCK=false
FORGEJO_DATA_DIR=./.forgejo/data
FORGEJO_REPOSITORY_DIR=./.forgejo/repositories
FORGEJO_CONFIG_DIR=./.forgejo/config
